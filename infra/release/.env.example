# Packaging/rehearsal template only. Replace example origins and secret paths before release.
# Use tested immutable image digests for promotion, not these local build tags.
APP_ENV=staging
ATLAS_API_IMAGE=atlas-api:release-local
ATLAS_MIGRATE_IMAGE=atlas-migrate:release-local
ATLAS_CUSTOMER_IMAGE=atlas-customer:release-local
ATLAS_SELLER_IMAGE=atlas-seller:release-local
CUSTOMER_WEB_ORIGIN=https://shop.example.invalid
SELLER_WEB_ORIGIN=https://seller.example.invalid
DATABASE_URL_FILE=./secrets/database-url
DATABASE_CA_FILE=./secrets/database-ca.pem
CUSTOMER_ACTION_KEY_FILE=./secrets/customer-action-key
SELLER_ACTION_KEY_FILE=./secrets/seller-action-key
IDENTITY_KEY_FILE=./secrets/identity-key
SMTP_URL_FILE=./secrets/smtp-url
SMS_TOKEN_FILE=./secrets/sms-token
SMS_GATEWAY_URL=
MAIL_FROM=Atlas DZ <no-reply@shop.example.invalid>
# Real cash-on-delivery checkout. Keep false until legal/operations sign-off.
ATLAS_LIVE_CHECKOUT=false
