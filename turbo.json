{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "dist-test/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"],
      "outputs": []
    },
    "test:contract": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": []
    },
    "test:ui": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": []
    },
    "test:security": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
