  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/noto-sans-arabic": "5.2.8",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "catalog:"
  }
}
