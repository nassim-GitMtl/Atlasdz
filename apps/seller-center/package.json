{
  "name": "@atlas/seller-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build && node ../../tools/deployment/prepare-web-artifact.mjs seller-center",
    "start": "node tools/start.mjs",
    "lint": "eslint src next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
