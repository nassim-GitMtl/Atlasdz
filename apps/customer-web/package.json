{
  "name": "@atlas/customer-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build && node tools/prepare-standalone.mjs",
    "start": "node tools/start.mjs",
    "lint": "eslint src next.config.ts tools",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "test:unit": "node --test src/lib/*.test.ts",
    "test:security": "node --test src/lib/customer-security.test.ts src/lib/session-revocation.test.ts",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/noto-sans-arabic": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "catalog:"
  }
}
