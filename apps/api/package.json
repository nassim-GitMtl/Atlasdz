{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist dist-test",
    "dev": "node --watch --env-file-if-exists=../../.env.local --import tsx src/main.ts",
    "start": "node dist/main.js",
    "create-staff": "node dist/create-staff.js",
    "start:local-catalog": "node --env-file-if-exists=../../.env.local dist/local-main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist-test/test/*.test.js",
    "test:unit": "node --test dist-test/test/*.test.js",
    "test:integration": "node --env-file-if-exists=../../.env.local --test dist-test/test/integration/*.test.js",
    "test:security": "node --test dist-test/test/*.test.js && node --env-file-if-exists=../../.env.local --test dist-test/test/integration/*.test.js"
  },
  "dependencies": {
    "@atlas/catalog": "workspace:*",
    "@atlas/commerce": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/identity": "workspace:*",
    "@atlas/identity-postgres": "workspace:*",
    "@atlas/platform": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prometheus-io/client": "0.16.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
