{
  "name": "@atlas/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist dist-test",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist-test/test/*.test.js",
    "test:unit": "node --test dist-test/test/*.test.js",
    "test:security": "node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
