{
  "name": "@atlas/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist dist-test",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist-test/test/unit/*.test.js",
    "test:unit": "node --test dist-test/test/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=../../.env.local --test dist-test/test/integration/*.test.js",
    "migrate": "node --env-file-if-exists=../../.env.local dist/cli.js migrate",
    "status": "node --env-file-if-exists=../../.env.local dist/cli.js status",
    "verify": "node --env-file-if-exists=../../.env.local dist/cli.js verify",
    "seed:synthetic": "node --env-file-if-exists=../../.env.local dist/cli.js seed-synthetic"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
