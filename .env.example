# Copy to .env.local for local-only synthetic development. Never commit secrets.
NODE_ENV=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://atlas_local:atlas_local_only@127.0.0.1:5432/atlas_local
DATABASE_SSL=false
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
REQUEST_BODY_LIMIT_BYTES=1048576

# These are deliberately locked off until their external approval gates close.
ENABLE_ELECTRONIC_PAYMENTS=false
ENABLE_REAL_PAYOUTS=false

# Local infrastructure only. Replace through an approved secret mechanism outside LOCAL.
ATLAS_POSTGRES_USER=atlas_local
ATLAS_POSTGRES_PASSWORD=atlas_local_only
ATLAS_POSTGRES_DB=atlas_local
ATLAS_REDIS_PASSWORD=atlas_local_only
ATLAS_RABBITMQ_USER=atlas_local
ATLAS_RABBITMQ_PASSWORD=atlas_local_only
# Required: 32 random bytes, base64 (openssl rand -base64 32). Encrypts sellers' TOTP secrets.
# IDENTITY_SECRET_KEY=
